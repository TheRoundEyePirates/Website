---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ArrowLeft, Mail } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrewPhotoGallery from '../../components/CrewPhotoGallery.tsx';
import TeamStatsPanel from '../../components/TeamStatsPanel.tsx';
import TypewriterBio from '../../components/TypewriterBio.tsx';
import { getCrewPhotos } from '../../lib/crew';

export async function getStaticPaths() {
  const entries = (await getCollection('crew')).filter((entry) => !entry.data.hidden);
  return entries.map((entry) => ({
    params: { key: entry.id.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'crew'>;
}

const { entry } = Astro.props;
const [folder, key] = entry.id.split('/');
const { first, last, title, nickname } = entry.data;
const name = `${title ? `${title} ` : ''}${first} ${last}`.trim();
const roleLabel = folder === 'officers' ? 'Officer & Coach' : 'Crew';
const email = entry.data.showEmail && nickname ? `${nickname.toLowerCase()}@theroundeyepirates.com` : null;
const photos = (await getCrewPhotos())[key] ?? [];
---

<BaseLayout
  title={`${name} — The Round Eye Pirates`}
  description={`Meet ${name}, ${roleLabel} for FTC Team 37060, The Round Eye Pirates.`}
>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <a
      href="/#crew"
      class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-ink/60 transition-colors hover:text-gold"
    >
      <ArrowLeft size={14} strokeWidth={1.5} aria-hidden="true" />
      Ship's Roster
    </a>

    <header
      data-animate="slide-up"
      class="mt-10 border border-ink/25 bg-card px-6 py-10 shadow-[4px_4px_0_rgba(212,160,44,0.12)] sm:px-10 sm:py-12"
    >
      <p class="font-mono text-xs uppercase tracking-[0.35em] text-gold">{roleLabel}</p>
      <h1 class="mt-3 font-pirate text-5xl text-ink sm:text-6xl">
        {first}
        {nickname && <span class="font-pirate text-3xl text-gold sm:text-4xl">&ldquo;{nickname}&rdquo;</span>}
        {' '}
        {last}
      </h1>
      {email && (
        <a
          href={`mailto:${email}`}
          class="mt-4 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-ink/60 transition-colors hover:text-gold"
        >
          <Mail size={13} strokeWidth={1.5} className="text-gold" aria-hidden="true" />
          {email}
        </a>
      )}
    </header>

    {photos.length > 0 ? (
      <section class="mt-10">
        <CrewPhotoGallery client:load photos={photos} name={name} />
      </section>
    ) : (
      <p class="mt-10 border border-ink/25 bg-card p-6 font-mono text-sm text-ink/70">
        No photos on board yet.
      </p>
    )}

    {entry.data.api && (
      <section class="mt-10">
        <TeamStatsPanel client:load team={entry.data.api.team} season={entry.data.api.season} />
      </section>
    )}

    {entry.data.live && entry.data.live.length > 0 && (
      <section class="mt-10 border border-ink/25 bg-card px-6 py-8 shadow-[4px_4px_0_rgba(212,160,44,0.12)] sm:px-10 sm:py-10">
        <div class="flex items-center gap-4" aria-hidden="true">
          <span class="h-px flex-1 bg-gold/40"></span>
          <span class="font-pirate text-lg uppercase tracking-[0.3em] text-gold">
            Live Display
          </span>
          <span class="h-px flex-1 bg-gold/40"></span>
        </div>
        <div class="mt-8 grid gap-8">
          {entry.data.live.map((embed) => (
            <figure>
              <figcaption class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.3em] text-gold">
                <span class="h-2 w-2 animate-pulse rounded-full bg-gold" aria-hidden="true"></span>
                {embed.label}
              </figcaption>
              <div
                class="overflow-hidden border border-ink/20 bg-sand shadow-[3px_3px_0_rgba(212,160,44,0.12)]"
                style={`aspect-ratio: ${embed.aspect}`}
              >
                <iframe
                  src={embed.url}
                  title={embed.label}
                  class="h-full w-full border-0"
                  loading="lazy"
                  allow="autoplay; encrypted-media; fullscreen; picture-in-picture; web-share"
                  allowfullscreen={true}
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10 border border-ink/25 bg-card px-6 py-8 sm:px-10 sm:py-10">
      <div class="flex items-center gap-4" aria-hidden="true">
        <span class="h-px flex-1 bg-gold/40"></span>
        <span class="font-pirate text-lg uppercase tracking-[0.3em] text-gold">
          Ship's Log
        </span>
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
      <div class="mt-8">
        <TypewriterBio client:visible text={entry.body ?? ''} />
      </div>
    </section>
  </main>
</BaseLayout>
