---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCrewPhotos } from '../../lib/crew';

export async function getStaticPaths() {
  const entries = await getCollection('crew');
  return entries.map((entry) => ({
    params: { key: entry.id.split('/')[0] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'crew'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const key = entry.id.split('/')[0];
const { first, last, title, nickname, role } = entry.data;
const name = `${title ? `${title} ` : ''}${first} ${last}`.trim();
const roleLabel = role === 'coach' ? 'Officer & Coach' : 'Crew';
const photos = getCrewPhotos()[key] ?? [];
---

<BaseLayout
  title={`${name} — The Round Eye Pirates`}
  description={`Meet ${name}, ${roleLabel} for FTC Team 37060, The Round Eye Pirates.`}
>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <a
      href="/#crew"
      class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-ink/60 transition-colors hover:text-gold"
    >
      <ArrowLeft size={14} strokeWidth={1.5} aria-hidden="true" />
      Ship's Roster
    </a>

    <header
      data-animate="slide-up"
      class="mt-10 border border-ink/25 bg-card px-6 py-10 shadow-[4px_4px_0_rgba(28,25,23,0.08)] sm:px-10 sm:py-12"
    >
      <p class="font-mono text-xs uppercase tracking-[0.35em] text-gold">{roleLabel}</p>
      <h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl">
        {first}
        {nickname && <span class="font-mono text-2xl text-gold sm:text-3xl">&ldquo;{nickname}&rdquo;</span>}
        {last}
      </h1>
    </header>

    {photos.length > 0 ? (
      <section class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {photos.map((src, index) => (
          <img
            src={src}
            alt={`${name} photo`}
            class="image-fade aspect-square w-full border border-ink/20 bg-ink/10 object-cover"
            style={{ animationDelay: `${index * 80}ms` }}
          />
        ))}
      </section>
    ) : (
      <p class="mt-10 border border-ink/25 bg-card p-6 font-mono text-sm text-ink/70">
        No photos on board yet — drop them into <code class="text-ink">src/content/crew/{key}/</code>.
      </p>
    )}

    <section class="mt-10 border border-ink/25 bg-card px-6 py-8 sm:px-10 sm:py-10">
      <h2 class="font-display text-2xl text-ink">Ship's Log</h2>
      <div class="log-body mt-6">
        <Content />
      </div>
    </section>
  </main>
</BaseLayout>
