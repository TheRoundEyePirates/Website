---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft, ExternalLink } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSponsorLogo } from '../../lib/sponsors';

export async function getStaticPaths() {
  const entries = await getCollection('sponsors');
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/')[0] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'sponsors'>;
}

const { entry } = Astro.props;
const { name, url, description } = entry.data;
const slug = entry.id.split('/')[0];
const logo = await getSponsorLogo(slug);
const { Content } = await render(entry);
---

<BaseLayout
  title={`${name} — The Round Eye Pirates`}
  description={description || `Learn more about ${name}, a sponsor of The Round Eye Pirates.`}
>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <a
      href="/our-sponsors/"
      class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-ink/60 transition-colors hover:text-gold"
    >
      <ArrowLeft size={14} strokeWidth={1.5} aria-hidden="true" />
      Our Sponsors
    </a>

    <header
      data-animate="slide-up"
      class="mt-10 text-center"
    >
      {logo && (
        <div class="mx-auto flex h-32 w-32 items-center justify-center sm:h-40 sm:w-40">
          <img
            src={logo.src}
            srcset={logo.srcSet}
            sizes={logo.sizes}
            width={logo.width}
            height={logo.height}
            alt={`${name} logo`}
            class="max-h-full w-auto object-contain"
            decoding="async"
          />
        </div>
      )}
      <h1 class="mt-6 font-pirate text-fluid-title text-ink">{name}</h1>
      {description && (
        <p class="mx-auto mt-4 max-w-xl font-mono text-sm leading-7 text-ink/70">{description}</p>
      )}
    </header>

    <section class="mt-10 border border-ink/25 bg-card px-6 py-8 sm:px-10 sm:py-10">
      <div class="flex items-center gap-4" aria-hidden="true">
        <span class="h-px flex-1 bg-gold/40"></span>
        <span class="font-pirate text-lg uppercase tracking-[0.3em] text-gold">
          About {name}
        </span>
        <span class="h-px flex-1 bg-gold/40"></span>
      </div>
      {url && (
        <div class="mt-6 text-center">
          <a
            href={url}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-gold/40 bg-gold/10 px-5 py-2 font-mono text-sm text-gold transition-colors hover:bg-gold/20"
          >
            {url} <ExternalLink size={14} strokeWidth={2} />
          </a>
        </div>
      )}
      <div class="mt-8 space-y-4 prose-p:font-mono prose-p:text-sm prose-p:leading-7 prose-p:text-ink/70 prose-headings:font-display prose-headings:text-ink prose-li:font-mono prose-li:text-sm prose-li:text-ink/70">
        <Content />
      </div>
    </section>
  </main>
</BaseLayout>
