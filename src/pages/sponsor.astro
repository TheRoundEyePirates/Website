---
import { getLogo } from '../lib/brand';
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.tsx';
import Footer from '../components/Footer.tsx';
import ShipDivider from '../components/ShipDivider.tsx';

const [lightLogo, darkLogo] = await Promise.all([getLogo('light'), getLogo('dark')]);
---

<BaseLayout
  title="Sponsor the Pirates — The Round Eye Pirates"
  description="Sponsorship tiers for FTC Team 37060, The Round Eye Pirates. Fund the voyage, put your name on the robot, and join us on the field."
>
  <NavBar client:load logo={lightLogo} />

  <main id="main" class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <ShipDivider label="Sponsor Us" color="#fbbf24" />

    <div class="mx-auto mt-10 max-w-2xl text-center">
      <div
        class="card-3d relative overflow-hidden rounded-3xl border border-gold/40 bg-card px-8 py-16 shadow-[4px_4px_0_rgba(212,160,44,0.18)]"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(212,160,44,0.14),rgba(212,160,44,0)_70%)]"
          aria-hidden="true"
        />

        <div class="animate-bounce text-6xl" aria-hidden="true">🏴‍☠️</div>

        <h1 class="mt-6 font-pirate text-5xl text-ink sm:text-6xl">Under Construction</h1>

        <p class="mx-auto mt-4 max-w-xl font-mono text-sm leading-7 text-ink/70">
          We're hammering planks and polishing cannons — our sponsorship tiers are being fitted
          out. Check back soon, or write to the crew if you'd like to chart a course together.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 rounded-full bg-gold px-7 py-3 font-mono text-xs font-bold uppercase tracking-[0.15em] text-sand shadow-lg transition-transform duration-200 hover:-translate-y-0.5"
          >
            Contact Us
          </a>
          <a
            href="mailto:hello@theroundeyepirates.com"
            class="inline-flex items-center gap-2 rounded-full border border-ink/25 bg-sand px-7 py-3 font-mono text-xs font-bold uppercase tracking-[0.15em] text-ink transition-colors duration-200 hover:border-gold/60 hover:text-gold"
          >
            hello@theroundeyepirates.com
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer client:visible logo={darkLogo} />
</BaseLayout>
