---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

import Animate from '../components/Animate.tsx';
import Navbar from '../components/Navbar.tsx';
import Hero from '../components/Hero.tsx';
import About from '../components/About.tsx';
import ShipSection from '../components/ShipSection.astro';
import RobotLog from '../components/RobotLog.tsx';
import Crew from '../components/Crew.tsx';
import MediaGallerySection from '../components/MediaGallerySection.astro';
import Bulletin from '../components/Bulletin.tsx';
import History from '../components/History.astro';
import QuoteTicker from '../components/QuoteTicker.tsx';
import GitHubRepos from '../components/GitHubRepos.tsx';
import Location from '../components/Location.tsx';
import Footer from '../components/Footer.tsx';
import TreasureChest from '../components/TreasureChest.tsx';
import CourseLine from '../components/CourseLine.tsx';
import { getLogo } from '../lib/brand';

const log = await getEntry('logs', 'robot-log');
if (!log) {
  throw new Error('Missing content entry: src/content/logs/robot-log.md');
}
const { Content } = await render(log);

const lightLogo = getLogo('light');
const darkLogo = getLogo('dark');
---

<BaseLayout
  title="The Round Eye Pirates — FTC Team 37060"
  description="FTC Team 37060, The Round Eye Pirates. A FIRST Tech Challenge team from Hawke's Bay, New Zealand, founded July 26, 2026. Nautical spirit meets engineering."
>
  <div slot="head">
    <meta property="og:url" content="https://round-eye-pirates.vercel.app/" />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "The Round Eye Pirates",
        "alternateName": "FTC Team 37060",
        "url": "https://round-eye-pirates.vercel.app",
        "email": "mailto:hello@roundeyepirates.dev",
        "foundingDate": "2026-07-26",
        "description": "FIRST Tech Challenge team based in Hawke's Bay, New Zealand. Nautical spirit meets engineering.",
        "sport": "FIRST Tech Challenge",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Hastings",
          "addressRegion": "Hawke's Bay",
          "addressCountry": "NZ"
        }
      }
    </script>
  </div>

  <a class="skip-link" href="#main">Skip to content</a>

  <Animate client:load />
  <Navbar client:load logo={lightLogo} />

  <main id="main">
    <Hero client:visible />
    <About client:visible />
    <ShipSection />
    <RobotLog client:visible {...log.data}>
      <Content />
    </RobotLog>
    <Crew />
    <MediaGallerySection />
    <Bulletin client:visible />
    <History />
    <QuoteTicker client:visible />
    <GitHubRepos client:visible />
    <Location />
  </main>

  <Footer client:visible logo={darkLogo} />
  <CourseLine client:load />
  <TreasureChest client:load />
</BaseLayout>
