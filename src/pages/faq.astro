---
import { getLogo } from '../lib/brand';
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.tsx';
import Footer from '../components/Footer.tsx';
import ShipDivider from '../components/ShipDivider.tsx';

const [lightLogo, darkLogo] = await Promise.all([getLogo('light'), getLogo('dark')]);

const faqs = [
  {
    q: 'What is FIRST Tech Challenge?',
    a: 'FIRST Tech Challenge (FTC) is a global robotics competition where student teams design, build, and program a robot to play a brand-new game every season. Teams are judged on more than matches alone — engineering process, teamwork, and community outreach count just as much. FTC sits alongside FIRST LEGO League and FIRST Robotics Competition under the FIRST umbrella.',
  },
  {
    q: 'Who are the Round Eye Pirates?',
    a: 'We are a rookie FTC team from Hawke\'s Bay, New Zealand — team number 37060. We are a crew of students who love building, coding, and engineering, held together by a shared love of robots and an even bigger love of pirate puns. The ship set sail in July 2026.',
  },
  {
    q: 'What happens during a build season?',
    a: 'Each season runs from the game reveal in September through competition season in the summer. The crew moves through a familiar rhythm: studying the rules, designing the robot, building and wiring it, writing the code, then endless rounds of testing and iterating. Along the way we keep an engineering notebook that tells the whole story of the build.',
  },
  {
    q: 'Where do you compete?',
    a: 'We compete at the National Championship in Hastings, New Zealand — our team goes straight there, no qualifying events in between. Since it is home turf for us, there are no travel costs to worry about. Along the way we also run demos and outreach in the Hawke\'s Bay community.',
  },
  {
    q: 'How can I support or sponsor the team?',
    a: 'Sponsors and supporters help pay for parts and entry fees — and we would love to have you on board. Since we head straight to nationals on home turf, travel costs are not a worry. Reach out through the contact page and we will talk charters and treasure maps.',
  },
];
---

<BaseLayout
  title="FAQ — The Round Eye Pirates"
  description="Answers to common questions about FIRST Tech Challenge, the Round Eye Pirates, and how to join our FTC team."
>
  <NavBar client:load logo={lightLogo} />

  <main id="main" class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
    <ShipDivider label="FAQ" />

    <h1 class="font-pirate text-fluid-title text-ink">Tales from the Crow's Nest</h1>

    <p class="mt-4 font-mono text-sm leading-7 text-ink/70">
      Everything the curious sailor asks about FIRST Tech Challenge and the Round Eye Pirates.
    </p>

    <div class="mt-4 flex justify-end">
      <button
        type="button"
        id="faq-toggle"
        class="btn-press font-mono text-xs uppercase tracking-[0.25em] text-gold transition-colors hover:text-navy"
      >
        Expand All
      </button>
    </div>

    <div class="mt-6 space-y-4">
      {faqs.map((faq) => (
        <div class="border border-ink/25 bg-card shadow-[4px_4px_0_rgba(212,160,44,0.12)]">
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-display text-lg text-ink transition-colors hover:text-gold marker:hidden">
              {faq.q}
              <span
                class="shrink-0 font-mono text-gold transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="border-t border-ink/10 px-6 py-5">
              <p class="font-mono text-sm leading-7 text-ink/75">{faq.a}</p>
            </div>
          </details>
        </div>
      ))}
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('faq-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var details = document.querySelectorAll('main details');
          var allOpen = Array.from(details).every(function (d) { return d.open; });
          details.forEach(function (d) { d.open = !allOpen; });
          btn.textContent = allOpen ? 'Expand All' : 'Collapse All';
        });
      })();
    </script>

    <div class="mt-12 border border-ink/25 bg-card p-6 text-center shadow-[4px_4px_0_rgba(212,160,44,0.12)]">
      <p class="font-mono text-sm text-ink/70">
        Still wondering?{' '}
        <a href="/contact/" class="text-gold underline-offset-2 hover:underline">
          Send word to the crew
        </a>
        .
      </p>
    </div>
  </main>

  <Footer client:visible logo={darkLogo} />
</BaseLayout>
