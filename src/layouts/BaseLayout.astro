---
import '../styles/global.css';
import DeepSeaBackground from '../components/DeepSeaBackground.tsx';

interface Props {
  title: string;
  description: string;
  /** Set to true to ask search engines not to index the page. */
  noindex?: boolean;
  themeColor?: string;
}

const {
  title,
  description,
  noindex = false,
  themeColor = '#0a0a0f',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Pirata+One&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />

    <script is:inline>
      // Theme: default is the black-sea "dark" look; a stored choice wins.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var dark = stored ? stored === 'dark' : true;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <DeepSeaBackground client:load />
    <div id="boot" aria-hidden="true">
      <div class="boot-inner">
        <p class="boot-title">The Round Eye Pirates</p>
        <p class="boot-sub">FTC Team 37060</p>

        <!-- From Uiverse.io by ashif_6672 -->
        <div class="dino-loader">
          <div class="dino-runner"></div>
          <div class="dino-obstacle"></div>
          <div class="dino-ground"></div>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var boot = document.getElementById('boot');
        if (!boot || !document.documentElement.classList.contains('js')) return;

        // Always show on first visit to the site; on later reloads in the
        // same session, show it again roughly 1 in 9 times.
        var firstVisit = sessionStorage.getItem('boot') === null;
        var show = firstVisit || Math.random() < 1 / 9;

        if (!show) {
          boot.remove();
          return;
        }

        sessionStorage.setItem('boot', '1');

        setTimeout(function () {
          boot.classList.add('boot-done');
          setTimeout(function () {
            boot.remove();
          }, 700);
        }, 1200);
      })();
    </script>

    <slot />
  </body>
</html>
