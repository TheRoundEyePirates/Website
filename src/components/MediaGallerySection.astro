---
import ShipDivider from './ShipDivider';
import MediaGallery from './MediaGallery';
import { getMedia } from '../lib/media';

const media = getMedia();
---

<section
  id="gallery"
  class="section-accent section-tint mx-auto max-w-5xl scroll-mt-24 px-6 py-24 sm:py-32"
  style="--accent: #a78bfa"
>
  <span class="section-orb orb-a" data-parallax="0.3" aria-hidden="true" />
  <span class="section-orb orb-b" data-parallax="0.4" aria-hidden="true" />

  <ShipDivider label="Gallery" color="#a78bfa" />

  <h2 data-animate="blur" class="font-display text-3xl text-ink sm:text-4xl">
    Ship's Album
  </h2>

  <p data-animate="fade-in" data-delay="0.1" class="mt-4 max-w-xl font-mono text-sm leading-7 text-ink/70">
    Snapshots from the build bay and the field.
  </p>

  <div data-animate="fade-up" data-delay="0.15" class="mt-10">
    <MediaGallery media={media} client:visible />
  </div>
</section>
