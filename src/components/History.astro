---
import { getCollection, render } from 'astro:content';
import ShipDivider from './ShipDivider';

const events = (await getCollection('timeline')).sort(
  (a, b) => a.data.order - b.data.order,
);

const renderedEvents = await Promise.all(
  events.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
---

<section id="history" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-24 sm:py-32">
  <ShipDivider label="History" />

  <h2 data-animate="blur" class="font-display text-3xl text-ink sm:text-4xl">
    Ship's Log
  </h2>

  <div class="relative mt-12 pl-10">
    <span
      data-draw
      class="absolute bottom-2 top-2 left-[9px] border-l-2 border-dotted border-ink/25"
      aria-hidden="true"
    />

    <ol data-stagger class="space-y-12">
      {
        renderedEvents.map(({ entry, Content }) => (
          <li class="relative">
            <span
              class="absolute -left-10 top-0 flex h-5 w-5 items-center justify-center rounded-full border border-gold/60 bg-parchment text-gold"
              aria-hidden="true"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="5" r="3" />
                <line x1="12" x2="12" y1="22" y2="8" />
                <path d="M5 12H2a10 10 0 0 0 20 0h-3" />
              </svg>
            </span>
            <time class="font-mono text-xs uppercase tracking-[0.25em] text-gold">
              {entry.data.date}
            </time>
            <h3 class="mt-2 font-display text-2xl text-ink">{entry.data.title}</h3>
            <div class="timeline-body mt-2 max-w-md text-sm leading-7 text-ink/75">
              <Content />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
